# Keep the real file at /etc/deploy-telegram-notifier.env with mode 0600.
TELEGRAM_BOT_TOKEN=replace-with-the-token-from-botfather
TELEGRAM_CHAT_ID=replace-with-private-chat-group-or-channel-id
# TELEGRAM_MESSAGE_THREAD_ID=42
# DEPLOY_NOTIFIER_STATE_DIR=/var/lib/deploy-telegram-notifier
# Optional fallback public URL. A project-specific Compose label takes precedence.
# DEPLOY_NOTIFIER_APP_URL=https://app.example.com
# DEPLOY_NOTIFIER_DELAY_THRESHOLD=5m
